START
-----------------------------------------
DISPLAY "Enter the number of hours worked: "
INPUT hours_worked
------------------------------------------
IF hours_worked > 40 THEN
    regular_pay = 40 * 20
    overtime_hours = hours_worked - 40
    overtime_pay = overtime_hours * 30
    weekly_pay = regular_pay + overtime_pay
ELSE
    weekly_pay = hours_worked * 20
ENDIF
------------------------------------------
DISPLAY "Weekly Pay: $" + weekly_pay
------------------------------------------
END
