# Paycheck Calculator Pseudocode Template
#
# Replace every TODO prompt with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Your finished pseudocode should represent the same logic as your flowchart.
# Use clear indentation and ALLCAPS pseudocode keywords, such as GET (input),
# PUT (output), LET (assignment), IF, ELSE, and ENDIF where they fit your design.

START paycheck_calculator

// Define constants
SET REGULAR_RATE = 20
SET OVERTIME_RATE = 30
SET REGULAR_HOURS_LIMIT = 40

// Input step
DISPLAY "Enter the number of hours worked: "
INPUT hours_worked

// Decision branching and processing steps 
IF hours_worked > REGULAR_HOURS_LIMIT THEN
    SET regular_pay = REGULAR_HOURS_LIMIT * REGULAR_RATE
    SET overtime_hours = hours_worked - REGULAR_HOURS_LIMIT
    SET overtime_pay = overtime_hours * OVERTIME_RATE
    SET weekly_pay = regular_pay + overtime_pay
ELSE
    SET weekly_pay = hours_worked * REGULAR_RATE
ENDIF

// Output step
DISPLAY "Weekly Pay: $" + weekly_pay
