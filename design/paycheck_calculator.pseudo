START paycheck_calculator

     // Define constants
     SET REGULAR_HOURS_LIMIT = 40
     SET REGUALR_RATE = 20
     SET OVERTIME_RATE = 30

     // Input step
     DISPLAY "Enter the number of hours worked: "
     INPUT hours_worked

     // Decision branching and processing step
     IF hours_worked > REGULAR_HOURS_LIMIT THEN
         SET regular_pay = REGULAR_HOURS_LIMIT * REGULAR_RATE
         SET overtime_hours = hours_worked - REGULAR_HOURS_LIMIT
         SET overtime_pay = overtime_hours * OVERTIME_RATE
         SET weekly_pay = regular_pay + overtime_pay
     ELSE
         SET weekly_pay = hours_worked * REGULAR_RATE
     ENDIF

     // Output step
     DISPLAY "Weekly pay: $" + weekly_pay

END paycheck_calculator
